############################################
# Application
############################################
APP_NAME=notification-platform
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

############################################
# Backend
############################################
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

############################################
# Frontend
############################################
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost/api/v1

############################################
# PostgreSQL
############################################
POSTGRES_HOST=notification-postgres
POSTGRES_PORT=5432
POSTGRES_DB=notification_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@notification-postgres:5432/notification_platform

############################################
# Redis
############################################
REDIS_HOST=notification-redis
REDIS_PORT=6379
REDIS_URL=redis://notification-redis:6379/0

############################################
# Worker
############################################
CELERY_BROKER_URL=redis://notification-redis:6379/0
CELERY_RESULT_BACKEND=redis://notification-redis:6379/0

############################################
# Nginx
############################################
NGINX_PORT=80

############################################
# Email (Future)
############################################
EMAIL_PROVIDER=
SENDGRID_API_KEY=

############################################
# SMS (Future)
############################################
SMS_PROVIDER=
AFRICASTALKING_API_KEY=

############################################
# WhatsApp (Future)
############################################
WHATSAPP_PROVIDER=
META_ACCESS_TOKEN=

############################################
# Monitoring (Future)
############################################
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000