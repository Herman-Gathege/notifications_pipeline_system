############################################
# Application
############################################
APP_NAME=FikaTu
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

############################################
# Backend
############################################
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

############################################
# Frontend
############################################
FRONTEND_PORT=5174
VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:8001

############################################
# PostgreSQL
############################################
POSTGRES_HOST=notification-postgres
POSTGRES_PORT=5432
POSTGRES_DB=notification_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+psycopg://postgres:postgres@notification-postgres:5432/notification_platform


############################################
# Redis
############################################
REDIS_HOST=notification-redis
REDIS_PORT=6379
REDIS_URL=redis://notification-redis:6379/0

############################################
# Worker
############################################
CELERY_BROKER_URL=redis://notification-redis:6379/0
CELERY_RESULT_BACKEND=redis://notification-redis:6379/0

############################################
# Nginx
############################################
NGINX_PORT=80

############################################
# Email (Future)
############################################
EMAIL_PROVIDER=
SENDGRID_API_KEY=

############################################
# SMS (Future)
############################################
SMS_PROVIDER=
AFRICASTALKING_API_KEY=

############################################
# WhatsApp (Future)
############################################
WHATSAPP_PROVIDER=
META_ACCESS_TOKEN=

############################################
# Monitoring (Future)
############################################
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

############################################
# SendGrid
############################################
SENDGRID_API_KEY=SG_xxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=FikaTu

############################################
# Resend
############################################
RESEND_API_KEY=re_your_mock_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=FikaTu

############################################
# Africa's Talking
############################################
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=atpk_test_your_api_key_here
AFRICASTALKING_SENDER_ID=

############################################
# Admin Bootstrap
############################################
# Initial admin credentials (required on first migration)
# Used by alembic migration a1b2c3d4e5f6 to seed the first admin user.
# Only creates the admin if the user does not already exist.
INITIAL_ADMIN_EMAIL=admin@notification-platform
INITIAL_ADMIN_PASSWORD=admin123
